# Optional overrides. Paths can be absolute or relative to the repository root.
FINANCE_MODEL_DIR=services/finance/models
ANOMALY_MODEL_PATH=services/anomaly/models/isolation_forest.joblib
PHISHING_MODEL_PATH=services/phishing/models/phishing_distilbert
PHISHING_TORCH_THREADS=1
# Comma-separated browser origins; empty means same-origin access only.
CORS_ORIGINS=
# Includes local uploads, sales observations, schedules, keys (hashes), and notifications.
DECISIONIQ_DB_PATH=data/dashboard.sqlite3

# Optional external origin behind a reverse proxy; empty uses the request origin.
FORESIGHT_ORIGIN=
# Enable only when serving over HTTPS. HTTPS also enables Secure cookies automatically.
FORESIGHT_SECURE_COOKIES=0

# Optional ignored local data; missing files do not prevent private-workspace startup.
FORESIGHT_DEMO_SALES_PATH=services/finance/data/demo_sales.csv
FINANCE_HISTORY_PATH=services/finance/data/revenue_history.csv
